@page "{category?}"
@model OnlineStore.Webapp.Pages.Products.IndexModel
@{
    ViewData["Title"] = "Catálogo de Produtos";
}

<div class="container mt-4">
    <div class="row">

        <!-- Coluna de Filtros -->
        <aside class="col-lg-3 col-md-4 mb-4">
            <div class="card shadow-sm">
                <div class="card-header bg-primary text-white">
                    <h5 class="mb-0">Filtros</h5>
                </div>
                <div class="card-body">
                    <form method="get">
                        <input asp-for="PageNumber" value="1" type="hidden" />
                        <input asp-for="PageSize" type="hidden" />
                        <input asp-for="Order" type="hidden" />
                        <div class="mb-3">
                            <label class="form-label fw-bold">Preço</label>
                            <div class="d-flex align-items-center">
                                <input asp-for="MinPrice" type="text" inputmode="decimal" class="form-control form-control-sm" placeholder="Min" />
                                <span class="mx-2">-</span>
                                <input asp-for="MaxPrice" type="text" inputmode="decimal" class="form-control form-control-sm" placeholder="Max" /> 
                            </div>
                        </div>
                        @if(!string.IsNullOrEmpty(Model.Search))
                        {
                            <input asp-for="Search" type="hidden" />
                        }
                        <button type="submit" class="btn btn-outline-primary w-100">Filtrar</button>
                    </form>
                </div>
            </div>
        </aside>

        <!-- Coluna Principal -->
        <section class="col-lg-9 col-md-8">

            <!-- Barra de Ferramentas: Ordenação e Quantidade -->
            <div class="d-flex flex-wrap justify-content-between align-items-center mb-4 bg-light p-3 rounded shadow-sm">
                <form method="get" class="d-flex gap-3 w-100">
                    <input asp-for="PageNumber" value="1" type="hidden" />      
                    <div class="d-flex align-items-center">
                        <label class="text-nowrap me-2 mb-0">Itens por página:</label>
                        <select asp-for="PageSize" class="form-select form-select-sm" onchange="this.form.submit()">
                            <option value="12" selected="@(Model.ProductsPage.CurrentSize == 12)">12</option>
                            <option value="24" selected="@(Model.ProductsPage.CurrentSize == 24)">24</option>
                            <option value="36" selected="@(Model.ProductsPage.CurrentSize == 36)">36</option>
                        </select>
                    </div>
                    <div class="d-flex align-items-center ms-auto">
                        <label class="text-nowrap me-2 mb-0">Ordenar por:</label>
                        <select asp-for="Order" class="form-select form-select-sm" onchange="this.form.submit()">
                            <option value="relevancia">Relevância</option>
                            <option value="menorPreco">Menor Preço</option>
                            <option value="maiorPreco">Maior Preço</option>
                        </select>
                    </div>
                    @if(Model.MinPrice.HasValue)
                    {
                        <input asp-for="MinPrice" type="hidden" />
                    }
                    @if (Model.MaxPrice.HasValue)
                    {
                        <input asp-for="MaxPrice" type="hidden" />
                    }
                    @if(!string.IsNullOrEmpty(Model.Search))
                    {
                        <input asp-for="Search" type="hidden" />
                    }
                </form>
            </div>

            <!-- Grid de Produtos (4 Colunas) -->

            @if (Model.ProductsPage != null && Model.ProductsPage.Items.Any())
            {
                <div class="row row-cols-1 row-cols-md-2 row-cols-lg-4 g-4 mb-4">
                    @foreach (var produto in Model.ProductsPage.Items)
                    {
                    <div class="col">
                        <div class="card h-100 shadow-sm">
                            <img src="@produto.MainImageUrl" class="card-img-top" alt="Imagem do Produto">
                            <div class="card-body d-flex flex-column">
                                <h6 class="card-title text-truncate">@produto.Name</h6>
                                <h5 class="card-text text-primary mt-auto">R$ @produto.Price.ToString("N2")</h5>
                            </div>
                            <div class="card-footer bg-transparent border-top-0 pb-3">
                                <a class="btn btn-primary w-100" asp-page="/Products/Detail" asp-route-id="@produto.Id">Ver Detalhes</a>
                            </div>
                        </div>
                    </div>
                    }
                </div>
            }
            else
            {
                <div class="col-12 text-center">
                    <p class="text-muted">Nenhum produto encontrado.</p>
                </div>
            }
            

            <!-- Paginação -->
            @if (Model.ProductsPage != null)
            {
                <nav aria-label="Navegação de páginas de produtos">
                    <ul class="pagination justify-content-center">
                        <!-- Botão Preview (Anterior) -->
                        <li class="page-item @(!Model.ProductsPage.HasPreviousPage ? "disabled" : "")">
                            <a asp-page="/Products/Index"
                                asp-route-Category="@Model.Category"
                                asp-route-PageNumber="@(Model.ProductsPage.CurrentPage - 1)"
                                asp-route-PageSize="@Model.PageSize"
                                asp-route-Order="@Model.Order"
                                asp-route-MinPrice="@Model.MinPrice"
                                asp-route-MaxPrice="@Model.MaxPrice"
                                asp-route-Search="@Model.Search" 
                                class="page-link" aria-label="Anterior">
                                <span aria-hidden="true">&laquo; Anterior</span>
                            </a>
                        </li>

                        <!-- Indicador de Página Atual -->
                        <li class="page-item disabled d-none d-md-block">
                            <span class="page-link">Página @Model.ProductsPage.CurrentPage de @Model.ProductsPage.TotalPages</span>
                        </li>

                        <!-- Botão Próxima -->
                        <li class="page-item @(!Model.ProductsPage.HasNextPage ? "disabled" : "")">
                            <a asp-page="/Products/Index" 
                                asp-route-Category="@Model.Category"
                                asp-route-PageNumber="@(Model.ProductsPage.CurrentPage + 1)"
                                asp-route-PageSize="@Model.PageSize"
                                asp-route-Order="@Model.Order"
                                asp-route-MinPrice="@Model.MinPrice"
                                asp-route-MaxPrice="@Model.MaxPrice"
                                asp-route-Search="@Model.Search" 
                                class="page-link" aria-label="Próxima">
                                <span aria-hidden="true">Próxima &raquo;</span>
                            </a>
                        </li>
                    </ul>
                </nav>
            }

        </section>
    </div>
</div>