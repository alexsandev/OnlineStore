@page
@model OnlineStore.Webapp.Pages.Products.IndexModel
@{
    ViewData["Title"] = "Catálogo de Produtos";
}

<div class="container mt-4">
    <div class="row">

        <!-- Coluna de Filtros -->
        <aside class="col-lg-3 col-md-4 mb-4">
            <div class="card shadow-sm">
                <div class="card-header bg-primary text-white">
                    <h5 class="mb-0">Filtros</h5>
                </div>
                <div class="card-body">
                    <form method="get">
                        <!-- Preservar paginação e tamanho ao filtrar -->
                        <input type="hidden" name="page" value="1" />
                        <input type="hidden" name="size" value="@Model.ProductPage.CurrentSize" />

                        <div class="mb-3">
                            <label class="form-label fw-bold">Categoria</label>
                            <select class="form-select" name="category">
                                <option value="">Todas</option>
                                <option value="eletronicos">Eletrônicos</option>
                                <option value="hardware">Hardware</option>
                            </select>
                        </div>

                        <div class="mb-3">
                            <label class="form-label fw-bold">Preço</label>
                            <div class="d-flex align-items-center">
                                <input type="number" class="form-control form-control-sm" name="minPrice" placeholder="Min" />
                                <span class="mx-2">-</span>
                                <input type="number" class="form-control form-control-sm" name="maxPrice" placeholder="Max" />
                            </div>
                        </div>

                        <button type="submit" class="btn btn-outline-primary w-100">Aplicar Filtros</button>
                    </form>
                </div>
            </div>
        </aside>

        <!-- Coluna Principal -->
        <section class="col-lg-9 col-md-8">

            <!-- Barra de Ferramentas: Ordenação e Quantidade -->
            <div class="d-flex flex-wrap justify-content-between align-items-center mb-4 bg-light p-3 rounded shadow-sm">
                <form method="get" class="d-flex gap-3 w-100">
                    <input type="hidden" name="page" value="1" />

                    <div class="d-flex align-items-center">
                        <label class="text-nowrap me-2 mb-0">Itens por página:</label>
                        <select class="form-select form-select-sm" name="size" onchange="this.form.submit()">
                            <option value="10" selected="@(Model.ProductPage.CurrentSize == 10)">10</option>
                            <option value="20" selected="@(Model.ProductPage.CurrentSize == 20)">20</option>
                            <option value="30" selected="@(Model.ProductPage.CurrentSize == 30)">30</option>
                        </select>
                    </div>

                    <div class="d-flex align-items-center ms-auto">
                        <label class="text-nowrap me-2 mb-0">Ordenar por:</label>
                        <select class="form-select form-select-sm" name="sort" onchange="this.form.submit()">
                            <option value="relevancia">Relevância</option>
                            <option value="menorPreco">Menor Preço</option>
                            <option value="maiorPreco">Maior Preço</option>
                        </select>
                    </div>
                </form>
            </div>

            <!-- Grid de Produtos (3 Colunas) -->
           
            @if (Model.ProductPage != null && Model.ProductPage.Items.Any())
            {
                <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4 mb-4">
                    @foreach (var produto in Model.ProductPage.Items)
                    {
                    <div class="col">
                        <div class="card h-100 shadow-sm">
                            <img src="https://placehold.co/300x200" class="card-img-top" alt="Imagem do Produto">
                            <div class="card-body d-flex flex-column">
                                <h6 class="card-title text-truncate">@produto.Name</h6>
                                <h5 class="card-text text-primary mt-auto">R$ @produto.Price.ToString("N2")</h5>
                            </div>
                            <div class="card-footer bg-transparent border-top-0 pb-3">
                                <a class="btn btn-primary w-100" asp-page="/Products/Detail" asp-route-id="@produto.Id">Ver Detalhes</a>
                            </div>
                        </div>
                    </div>
                    }
                </div>
            }
            else
            {
                <div class="col-12 text-center">
                    <p class="text-muted">Nenhum produto encontrado.</p>
                </div>
            }
            

            <!-- Paginação -->
            @if (Model.ProductPage != null)
            {
                <nav aria-label="Navegação de páginas de produtos">
                    <ul class="pagination justify-content-center">
                        <!-- Botão Preview (Anterior) -->
                        <li class="page-item @(!Model.ProductPage.HasPreviousPage ? "disabled" : "")">
                            <a class="page-link" href="?page=@(Model.ProductPage.CurrentPage - 1)&size=@Model.ProductPage.CurrentSize" aria-label="Anterior">
                                <span aria-hidden="true">&laquo; Anterior</span>
                            </a>
                        </li>

                        <!-- Indicador de Página Atual -->
                        <li class="page-item disabled d-none d-md-block">
                            <span class="page-link">Página @Model.ProductPage.CurrentPage de @Model.ProductPage.TotalPages</span>
                        </li>

                        <!-- Botão Próxima -->
                        <li class="page-item @(!Model.ProductPage.HasNextPage ? "disabled" : "")">
                            <a class="page-link" href="?page=@(Model.ProductPage.CurrentPage + 1)&size=@Model.ProductPage.CurrentSize" aria-label="Próxima">
                                <span aria-hidden="true">Próxima &raquo;</span>
                            </a>
                        </li>
                    </ul>
                </nav>
            }

        </section>
    </div>
</div>